# Environment variables
# Copy to .env.local — never commit secrets.

# Supabase project: https://supabase.com/dashboard/project/fneitubfxquybvexlole
NEXT_PUBLIC_SUPABASE_URL=https://fneitubfxquybvexlole.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias used by newer Supabase docs. Either this or ANON_KEY is enough.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# 32+ random bytes. Used to encrypt mailbox tokens later.
ENCRYPTION_KEY=

# System notifications (not customer mailboxes)
RESEND_API_KEY=

# AI analysis adapter (not used for auto-send in V1)
CLAUDE_API_KEY=

# Customer mailbox OAuth (prepared, not enabled in V1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

APP_URL=http://localhost:3000
